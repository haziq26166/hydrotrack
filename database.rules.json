{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        "claimed_by": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
        },
        "live_data": {
          ".write": "auth != null && (auth.uid === 'FIRMWARE_UID' || auth.token.email === 'hydrotrack@gmail.com')"
        },
        "settings": {
          ".write": "auth != null && auth.uid === data.parent().child('claimed_by').val()"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'hydrotrack@gmail.com')",
          ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'hydrotrack@gmail.com')"
        }
      }
    }
  }
}
