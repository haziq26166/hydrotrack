{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null && (!data.child('claimed_by').exists() || data.child('claimed_by').val() === auth.uid || auth.uid === 'FIRMWARE_UID')",
        "claimed_by": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
        },
        "live_data": {
          ".write": "auth.uid === 'FIRMWARE_UID'"
        },
        "settings": {
          ".write": "auth != null && auth.uid === data.parent().child('claimed_by').val()"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": {
          ".read": "auth.uid === 'FIRMWARE_UID'",
          ".write": "auth.uid === 'FIRMWARE_UID'"
        }
      }
    }
  }
}