# ============================================================
# Gmail SMTP — used by the custom reset server (Nodemailer)
# ============================================================
EMAIL_USER=support.hydrotrack@gmail.com
EMAIL_PASS=abcd efgh ijkl mnop

# Optional — defaults already set inside reset-server.mjs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
FROM_EMAIL=support.hydrotrack@gmail.com
FROM_NAME=HydroTrack

# ============================================================
# Custom reset server
# ============================================================
RESET_PORT=8787
APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Path to your Firebase service-account JSON (needed for Admin SDK)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Legacy aliases (still read as fallback if you prefer not to rename)
