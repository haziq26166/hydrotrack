# ============================================================
# Gmail SMTP
# ============================================================
EMAIL_USER=support.hydrotrack@gmail.com
EMAIL_PASS=your_app_password_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
FROM_EMAIL=support.hydrotrack@gmail.com
FROM_NAME=HydroTrack

# ============================================================
# Custom reset / notification server
# ============================================================
RESET_PORT=8787
APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Path to your Firebase service-account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Your Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://hydrotrack-xxxxx-default-rtdb.firebaseio.com