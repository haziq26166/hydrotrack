# ============================================================
# HydroTrack Alert Dispatcher — environment configuration
# ============================================================
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit it.
# ============================================================

# ---------- SMTP (Gmail) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=support.hydrotrack@gmail.com
SMTP_PASS=your-16-char-app-password

FROM_EMAIL=support.hydrotrack@gmail.com
FROM_NAME=HydroTrack Alerts

# ---------- Firebase RTDB ----------
FIREBASE_DB_URL=https://hydrotrack-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SECRET=paste-your-legacy-database-secret

# ---------- Behaviour ----------
# Ignore alerts older than this when sending (seconds)
LOOKBACK_SECONDS=900